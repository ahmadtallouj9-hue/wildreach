{
  "name": "wildreach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mp": "concurrently -n web,mp -c cyan,magenta \"vite\" \"tsx server/index.ts\"",
    "server": "tsx server/index.ts",
    "build": "tsc && vite build",
    "test:gen": "tsx src/world/gen/determinism.test.ts",
    "test:ai": "tsx src/vythera_ai/vytheraAi.test.ts",
    "test:privacy": "tsx src/vythera_ai/security/privacy.test.ts",
    "test:multitask": "tsx src/vythera_ai/vision/learning/multitask.visual.test.ts",
    "test:train": "tsx scripts/vythera-train/train.test.ts",
    "test:modhub": "tsx src/modhub/modhub.test.ts",
    "test:online": "tsx src/online/privacy/privacy.test.ts && tsx scripts/_smoke_online.ts",
    "test:background": "tsx src/ui/background/background.test.ts",
    "test:landscape": "tsx src/world/gen/landscape.test.ts",
    "test:resolution": "tsx src/world/terrainResolution.test.ts",
    "test:terrainlab": "tsx src/dev/terrainlab/terrainlab.test.ts",
    "test": "npm run test:gen && npm run test:ai && npm run test:privacy && npm run test:multitask && npm run test:train && npm run test:modhub && npm run test:online && npm run test:background && npm run test:landscape && npm run test:resolution && npm run test:terrainlab && npm run test:worldstyle",
    "vythera:online": "tsx server/online/index.ts",
    "vythera:security:audit": "tsx scripts/vythera-security/audit.ts",
    "vythera:multitask:integration": "tsx scripts/vythera-train/run-multitask-integration.ts",
    "vythera:train": "tsx scripts/vythera-train/run-job.ts",
    "vythera:train:daemon": "tsx scripts/vythera-train/daemon.ts",
    "vythera:train:detect": "tsx scripts/vythera-train/run-job.ts --detect",
    "vythera:train:setup": "tsx scripts/vythera-train/setup.ts",
    "vythera:train:smoke": "tsx scripts/vythera-train/run-smoke.ts",
    "vythera:train:vlm-smoke": "tsx scripts/vythera-train/run-vlm-smoke.ts",
    "vythera:train:vlm-e2e": "tsx scripts/vythera-train/run-vlm-e2e.ts",
    "preview": "vite preview",
    "preview:mp": "concurrently -n web,mp -c cyan,magenta \"vite preview\" \"tsx server/index.ts\"",
    "deploy": "npx vercel --prod --yes",
    "deploy:prebuilt": "npm run build && npx vercel deploy --prod --yes",
    "deploy:surge": "npm run build && npx surge dist wildreach-game.surge.sh",
    "test:worldstyle": "tsx src/world/style/worldStyle.test.ts"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.185.1",
    "ws": "^8.18.3"
  }
}
